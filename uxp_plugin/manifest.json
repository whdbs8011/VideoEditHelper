{
  "manifestVersion": 5,
  "id": "com.storyboard.premierebuilder.uxp",
  "name": "Storyboard Builder",
  "version": "1.3.4",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "storyboard-builder-panel",
      "label": {
        "default": "Storyboard Builder"
      },
      "minimumSize": {
        "width": 320,
        "height": 480
      },
      "maximumSize": {
        "width": 1600,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 680
      }
    }
  ]
}
